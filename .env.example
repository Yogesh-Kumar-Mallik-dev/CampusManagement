# CampusManagement Environment Configuration

# Server
PORT=8080
ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=campus_password
POSTGRES_DB=campus_db
DATABASE_URL=postgres://campus_user:campus_password@localhost:5433/campus_db?sslmode=disable

# Redis Cache
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Client
API_BASE_URL=http://localhost:8080
