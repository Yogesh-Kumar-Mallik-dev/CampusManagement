# ==============================================================================
# CampusManagement Platform - Environment Configuration Example
# ==============================================================================
# Copy this file to .env to configure local development and production environments:
#   cp .env.example .env
# ==============================================================================

# Server & Application Runtime
PORT=8080
ENV=development

# Database & Pre-Seeding Toggles
# Set SEED_DEFAULTS=true to populate default sample departments, programs, and catalog on startup.
SEED_DEFAULTS=false
# Set ENABLE_MOCK_SEEDING=true only when testing client offline mock fallback scenarios.
ENABLE_MOCK_SEEDING=false

# PostgreSQL Database (Container port 5432 mapped to host port 5435 to avoid local conflicts)
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=campus_password
POSTGRES_DB=campus_db
DATABASE_URL=postgres://campus_user:campus_password@localhost:5435/campus_db?sslmode=disable

# Redis Cache & Session Store (Container port 6379 mapped to host port 6380)
REDIS_PORT=6380
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=

# Document & Blob Storage (Local filesystem or S3/MinIO)
# Supported drivers: local (default), s3
STORAGE_DRIVER=local
# Optional local storage path (defaults to ~/.campus_management/uploads if omitted)
STORAGE_LOCAL_DIR=

# S3 / MinIO Object Storage Configuration (Only required if STORAGE_DRIVER=s3)
# S3_BUCKET=campus-documents
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_USE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=http://localhost:9000/campus-documents

# Multi-Channel Payment Gateway & Merchant Settlement
# Supported providers: sandbox (default mock), razorpay
PAYMENT_GATEWAY_PROVIDER=sandbox
PAYMENT_GATEWAY_KEY_ID=sandbox_inst_key_campus_9901
PAYMENT_GATEWAY_KEY_SECRET=sandbox_secret_instituional_demo
PAYMENT_GATEWAY_WEBHOOK_SECRET=whsec_campus_default_secret_99
PAYMENT_MERCHANT_NAME=Babu Banarasi Das Institute of Technology & BBDIT College of Pharmacy
PAYMENT_MERCHANT_VPA=bbditcollect@sbi
PAYMENT_BANK_NAME=State Bank of India (SBI)
PAYMENT_BANK_IFSC=SBIN0001234
PAYMENT_BANK_BRANCH=Institutional Campus Main Branch

# Client API Transport Target
API_BASE_URL=http://localhost:8080
